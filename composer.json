{
    "name": "nails/module-related-content",
    "keywords":
    [],
    "homepage": "https://docs.nailsapp.co.uk/modules/other/related-content",
    "description": "A simple relation engine for Nails.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "php": ">=8",
        "ext-pdo": "*",
        "nails/common": "dev-develop",
        "hellopablo/related-content": "0.*",
        "phpstan/phpstan": "2.*"
    },
    "require-dev":
    {
        "phpunit/phpunit": "10.*",
        "phpstan/phpstan": "2.*"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\RelatedContent\\": "src/"
        }
    },
    "extra":
    {
        "nails":
        {
            "moduleName": "relatedContent",
            "type": "module",
            "namespace": "Nails\\RelatedContent\\",
            "data":
            {}
        }
    },
    "autoload-dev":
    {
        "psr-4":
        {
            "Nails\\RelatedContent\\Tests\\": "src/"
        }
    }
}